+        with self.assertRaisesRegex(AuditError, "range_offset_type"):
+            audit(self.path, hashlib.sha256(raw).hexdigest(), [(False, 9)], 2)
+
+    def test_199_is_count_insufficient_and_200_reaches_numeric_gates(self) -> None:
+        raw_199 = record(2, 10_000_000) * 199
