+        self.assertEqual(len(result["files"][0]["ranges_sha256"]), 64)
+        self.assertNotIn("durations", result)
+
+    def test_many_rejects_duplicate_inode_and_any_wrong_file_hash(self) -> None:
+        raw = record(2, 10_000_000)
+        first = self.make_input("first.raw", raw)
+        hardlink = Path(self.temp.name) / "linked.raw"
+        try:
+            hardlink.hardlink_to(first[0])
+        except OSError as exc:
+            self.skipTest(f"hard links unavailable: {exc}")
+        second = (hardlink, first[1], first[2])
+        with self.assertRaisesRegex(AuditError, "duplicate_raw_file_inode"):
+            audit_many([first, second], 2)
+
+        wrong_hash = (self.make_input("other.raw", raw)[0], "0" * 64, [(0, len(raw))])
+        with self.assertRaisesRegex(AuditError, "sha256_mismatch"):
+            audit_many([first, wrong_hash], 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
