+        self.assertEqual(result_200["selected_sample_count"], 200)
+        self.assertEqual(result_200["sample_count_gate"]["status"], "sufficient")
+        self.assertEqual(result_200["numeric_latency_gate"], "passed_numeric_only")
+        self.assertEqual(result_200["maximum_ns"], 10_000_000)
+
+    def test_single_long_tail_is_not_trimmed_from_nearest_rank_p99(self) -> None:
+        raw = record(2, 10_000_000) * 98 + record(2, 41_000_000)
