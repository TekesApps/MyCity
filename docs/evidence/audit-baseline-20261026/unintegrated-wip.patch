+                st_mtime_ns=original.st_mtime_ns,
+            )
+            setattr(changed, field, value)
+            self.assertFalse(_same_file_identity(original, changed))
+
+    def test_illegal_classes_and_boolean_integer_inputs_are_rejected(self) -> None:
+        raw = record(10, 10_000_000)
