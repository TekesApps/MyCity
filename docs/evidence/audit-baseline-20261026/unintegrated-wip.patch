@@ -0,0 +1,171 @@
+"""Source tests for duration_audit; not executed during the current window."""
+
+from __future__ import annotations
+
+import hashlib
+import tempfile
+import unittest
+from pathlib import Path
+
+from duration_audit import AuditError, _same_file_identity, audit, audit_many
+
+
+def record(class_index: int, duration_ns: int) -> bytes:
+    return bytes((class_index,)) + duration_ns.to_bytes(8, "little")
+
+
+class DurationAuditTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.path = Path(self.temp.name) / "cpu.raw"
+
+    def audit_bytes(self, raw: bytes, ranges: list[tuple[int, int]], class_index: int = 2):
+        self.path.write_bytes(raw)
+        return audit(self.path, hashlib.sha256(raw).hexdigest(), ranges, class_index)
+
+    def make_input(self, name: str, raw: bytes):
+        path = Path(self.temp.name) / name
+        path.write_bytes(raw)
+        return path, hashlib.sha256(raw).hexdigest(), [(0, len(raw))]
+
+    def test_wrong_hash_truncation_and_unaligned_range_are_rejected(self) -> None:
+        raw = record(2, 10_000_000)
+        self.path.write_bytes(raw)
+        with self.assertRaisesRegex(AuditError, "sha256_mismatch"):
+            audit(self.path, "0" * 64, [(0, len(raw))], 2)
+
+        self.path.write_bytes(raw[:-1])
+        with self.assertRaisesRegex(AuditError, "record_alignment"):
+            audit(self.path, hashlib.sha256(raw[:-1]).hexdigest(), [], 2)
+
+        self.path.write_bytes(raw * 2)
+        with self.assertRaisesRegex(AuditError, "range_record_alignment"):
+            audit(self.path, hashlib.sha256(raw * 2).hexdigest(), [(0, 8)], 2)
+
+    def test_overlapping_and_repeated_ranges_are_rejected(self) -> None:
+        raw = record(2, 10_000_000) * 3
+        for ranges in [[(0, 18), (9, 27)], [(0, 9), (0, 9)]]:
+            with self.subTest(ranges=ranges), self.assertRaisesRegex(AuditError, "ranges_overlap"):
+                self.audit_bytes(raw, ranges)
+
+    def test_symlink_is_not_accepted_as_raw_evidence(self) -> None:
+        raw = record(2, 10_000_000)
+        self.path.write_bytes(raw)
+        link = Path(self.temp.name) / "cpu-link.raw"
+        link.symlink_to(self.path)
+        with self.assertRaisesRegex(AuditError, "not_regular_or_symlink"):
+            audit(link, hashlib.sha256(raw).hexdigest(), [(0, len(raw))], 2)
+
+    def test_path_identity_comparison_covers_device_inode_size_and_mtime(self) -> None:
+        from types import SimpleNamespace
+
+        original = SimpleNamespace(st_dev=1, st_ino=2, st_size=9, st_mtime_ns=10)
+        self.assertTrue(_same_file_identity(original, original))
+        for field, value in [
+            ("st_dev", 3),
+            ("st_ino", 3),
