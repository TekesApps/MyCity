index 0000000..24a0b99
--- /dev/null
+++ b/docs/evidence/m0-t13a-rare-control-01/batch_audit.py
@@ -0,0 +1,125 @@
+"""Post-observer numeric crosscheck of claimed rare-batch duration ranges.
+
+This does not independently establish eligibility, process identity, snapshot
+overlap or 200 independent trials. Those remain separate acceptance work.
+"""
+import hashlib
+import json
+from pathlib import Path
+
+from duration_audit import audit_many
+
+LINE_CAP = 256 * 1024
+CLASSES = {2: "L2_claims_batch", 6: "air_source_page", 7: "air_cell_page"}
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def integer(value):
+    return type(value) is int and value >= 0
+
+
+def verify_reported_histogram(numeric, histogram):
+    """Crosscheck exact ranks against original conservative Rust intervals."""
+    count = numeric.get("selected_sample_count")
+    require(integer(count) and isinstance(histogram, dict)
+            and histogram.get("samples") == count, "histogram population mismatch")
+    for label, percent in (("p95", 95), ("p99", 99)):
+        bucket = histogram.get(label)
+        require(isinstance(bucket, dict), "histogram quantile missing")
+        rank = (count * percent + 99) // 100
+        require(type(bucket.get("nearest_rank")) is int and bucket["nearest_rank"] == rank,
+                "histogram nearest rank mismatch")
+        if not count:
+            continue
+        exact = numeric.get(label + "_ns")
+        lower, upper = bucket.get("lower_exclusive_ns"), bucket.get("upper_inclusive_ns")
+        require(integer(exact) and integer(lower) and integer(upper)
+                and ((exact == 0 and lower == 0 and upper == 0)
+                     or lower < exact <= upper), "exact quantile outside conservative interval")
+    return {"population_and_quantile_intervals": "matched_raw_numeric_values",
+            "eligibility_and_full_gate": "not_proven_by_numeric_crosscheck"}
+
+
+def audit_batch(model_root, source_sha256, binary_sha256, kind, phase):
+    from run import safe_file, reject_duplicate_keys, sha256
+    require(kind in ("claims", "source") and phase in ("smoke", "formal"), "unsupported batch")
+    model_root = Path(model_root).resolve(strict=True)
+    classes = [2] if kind == "claims" else [6, 7]
+    expected_trials = 1 if phase == "smoke" else 200
+    grouped = {cls: {} for cls in classes}
+    expected_counts = {cls: 0 for cls in classes}
+    observed_trial_rows = {cls: 0 for cls in classes}
+    ledger = safe_file(model_root, "trial-analysis.jsonl")
+    ledger_hash = hashlib.sha256()
+    completed = 0
+    with ledger.open("rb") as stream:
+        while True:
+            line = stream.readline(LINE_CAP + 1)
+            if not line:
+                break
+            require(len(line) <= LINE_CAP and line.endswith(b"\n"), "analysis line bound or truncation")
+            ledger_hash.update(line)
+            row = json.loads(line, object_pairs_hook=reject_duplicate_keys)
+            completed += 1
+            require(completed <= expected_trials and isinstance(row, dict), "unexpected analysis row")
+            require(type(row.get("ordinal")) is int and row["ordinal"] == completed, "trial ordinal mismatch")
+            trial = f"{kind}-{completed:03d}"
+            require(row.get("trial") == trial and row.get("stratum") == kind
+                    and row.get("source_sha256") == source_sha256
+                    and row.get("binary_sha256") == binary_sha256, "trial source/binary mismatch")
+            trial_root = model_root / "trials" / trial
+            ranges = row.get("eligible_duration_ranges")
+            require(isinstance(ranges, list) and len(ranges) <= 1024, "missing/bounded claimed ranges")
+            trial_counts = {cls: 0 for cls in classes}
+            for item in ranges:
+                require(isinstance(item, dict), "range object required")
+                path = safe_file(trial_root, item["path"])
+                start, end = item.get("start"), item.get("end")
+                require(integer(start) and integer(end) and end > start, "range bounds")
+                counts = item.get("expected_samples_by_class")
+                require(isinstance(counts, list) and len(counts) == 10
+                        and all(v is None or integer(v) for v in counts), "range expected class counts")
+                digest = item.get("expected_file_sha256")
+                require(isinstance(digest, str) and len(digest) == 64
+                        and all(c in "0123456789abcdef" for c in digest), "range SHA shape")
+                for cls in classes:
+                    count = counts[cls]
+                    if count is None:
+                        continue
+                    entry = grouped[cls].setdefault(path, {"sha256": digest, "ranges": [], "expected": 0})
+                    require(entry["sha256"] == digest, "one raw file has conflicting SHA assertions")
+                    entry["ranges"].append((start, end))
+                    entry["expected"] += count
+                    expected_counts[cls] += count
+                    trial_counts[cls] += count
+            for cls in classes:
+                observed_trial_rows[cls] += int(trial_counts[cls] > 0)
+    require(completed == expected_trials, "incomplete analysis ledger")
+    reports = {}
+    for cls in classes:
+        inputs = [(path, entry["sha256"], entry["ranges"])
+                  for path, entry in sorted(grouped[cls].items(), key=lambda pair: str(pair[0]))]
+        numeric = audit_many(inputs, cls)
+        require(numeric["selected_sample_count"] == expected_counts[cls], "raw total differs from claimed count")
+        for actual, (_, entry) in zip(numeric["files"], sorted(grouped[cls].items(), key=lambda pair: str(pair[0]))):
+            require(actual["selected_sample_count"] == entry["expected"], "raw per-file count differs from claim")
+        reports[CLASSES[cls]] = {
+            "numeric": numeric,
+            "claimed_trial_rows_with_samples": observed_trial_rows[cls],
+            "actual_independent_trial_identity_gate": "not_proven_by_numeric_audit",
+        }
+    require(sha256(ledger) == ledger_hash.hexdigest(), "analysis ledger changed during offline QA")
+    return {
+        "schema": "mycity-rare-batch-offline-numeric-audit-v1",
+        "source_sha256": source_sha256, "binary_sha256": binary_sha256,
+        "stratum": kind, "mode": phase, "observed_analysis_rows": completed,
+        "trial_analysis_sha256": ledger_hash.hexdigest(), "classes": reports,
+        "scope": "post-observer numeric QA of claimed ranges; not a new game or measurement process",
+        "eligibility_identity_snapshot_overlap_audit": "pending",
+        "normal_and_diagnostic_memory_gate": "not_proven_by_offline_QA",
+        "memory_16gb_gate": "not_run", "full_M0": "not_accepted",
+    }
diff --git a/docs/evidence/m0-t13a-rare-control-01/duration_audit.py b/docs/evidence/m0-t13a-rare-control-01/duration_audit.py
new file mode 100644
index 0000000..9e47e7c
--- /dev/null
+++ b/docs/evidence/m0-t13a-rare-control-01/duration_audit.py
@@ -0,0 +1,317 @@
+"""Numeric-only audit of frozen 9-byte CPU duration records.
+
+This module verifies file bytes and selected aligned ranges. It does not prove
+that a range is eligible, belongs to a process identity, overlaps an observer
+window, or satisfies a memory or full-M0 acceptance gate.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import stat
+from pathlib import Path
+from typing import Iterable
+
+RECORD_BYTES = 9
+RAW_BYTE_CAP = 128 * 1024
+MAX_RECORDS = RAW_BYTE_CAP // RECORD_BYTES
+MAX_INPUT_FILES = 600
+TOTAL_RAW_BYTE_CAP = 128 * 1024 * 1024
+MAX_VALID_FILE_BYTES = MAX_RECORDS * RECORD_BYTES
+EFFECTIVE_RAW_BYTE_CAP = min(
+    TOTAL_RAW_BYTE_CAP, MAX_INPUT_FILES * MAX_VALID_FILE_BYTES
+)
+MAX_TOTAL_RECORDS = EFFECTIVE_RAW_BYTE_CAP // RECORD_BYTES
+MIN_SAMPLES = 200
+P95_LIMIT_NS = 20_000_000
+P99_LIMIT_NS = 40_000_000
+
+
+class AuditError(ValueError):
+    """The raw stream or its caller-supplied identity/ranges are invalid."""
+
+
+def _is_int(value: object) -> bool:
+    # bool is a subclass of int, but must never be accepted as an offset/class.
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _same_file_identity(left: os.stat_result, right: os.stat_result) -> bool:
+    return (
+        left.st_dev == right.st_dev
+        and left.st_ino == right.st_ino
+        and left.st_size == right.st_size
+        and left.st_mtime_ns == right.st_mtime_ns
+    )
+
+
+def _validated_ranges(
+    ranges: Iterable[tuple[int, int]], file_size: int
+) -> list[tuple[int, int]]:
+    result: list[tuple[int, int]] = []
+    for item in ranges:
+        if len(result) >= MAX_RECORDS:
+            raise AuditError("too_many_ranges")
+        if not isinstance(item, (tuple, list)) or len(item) != 2:
+            raise AuditError("range_shape")
+        start, end = item
+        if not _is_int(start) or not _is_int(end):
+            raise AuditError("range_offset_type")
+        if start < 0 or end <= start or end > file_size:
+            raise AuditError("range_bounds")
+        if start % RECORD_BYTES or end % RECORD_BYTES:
+            raise AuditError("range_record_alignment")
+        result.append((start, end))
+
+    result.sort()
+    previous_end = -1
+    for start, end in result:
+        if start < previous_end:
+            raise AuditError("ranges_overlap")
+        previous_end = end
+    return result
+
+
+def _validate_inputs(expected_sha256: str, class_index: int) -> None:
+    if not isinstance(expected_sha256, str) or len(expected_sha256) != 64:
+        raise AuditError("expected_sha256_shape")
+    if any(char not in "0123456789abcdefABCDEF" for char in expected_sha256):
+        raise AuditError("expected_sha256_shape")
+    _validate_class_index(class_index)
+
+
+def _validate_class_index(class_index: int) -> None:
+    if not _is_int(class_index) or not 0 <= class_index <= 9:
+        raise AuditError("class_index")
+
+
+def _read_selected(
+    path: str | os.PathLike[str],
+    expected_sha256: str,
+    ranges: Iterable[tuple[int, int]],
+    class_index: int,
+    seen_inodes: set[tuple[int, int]] | None = None,
+) -> tuple[str, int, list[tuple[int, int]], list[int]]:
+    _validate_inputs(expected_sha256, class_index)
+    raw_path = Path(path)
+    try:
+        path_before = raw_path.lstat()
+        if stat.S_ISLNK(path_before.st_mode) or not stat.S_ISREG(path_before.st_mode):
+            raise AuditError("raw_file_not_regular_or_symlink")
+        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
+        with os.fdopen(os.open(raw_path, flags), "rb") as stream:
+            before = os.fstat(stream.fileno())
+            if not stat.S_ISREG(before.st_mode):
+                raise AuditError("raw_file_not_regular")
+            if not _same_file_identity(path_before, before):
+                raise AuditError("raw_file_path_changed_before_read")
+            inode = (before.st_dev, before.st_ino)
+            if seen_inodes is not None:
+                if inode in seen_inodes:
+                    raise AuditError("duplicate_raw_file_inode")
+                seen_inodes.add(inode)
+            file_size = before.st_size
+            if file_size > RAW_BYTE_CAP:
+                raise AuditError("raw_file_too_large")
+            if file_size % RECORD_BYTES:
+                raise AuditError("raw_file_record_alignment")
+            selected_ranges = _validated_ranges(ranges, file_size)
+
+            digest = hashlib.sha256()
+            durations: list[int] = []
+            range_index = 0
+            offset = 0
+            for _ in range(file_size // RECORD_BYTES):
+                record = stream.read(RECORD_BYTES)
+                if len(record) != RECORD_BYTES:
+                    raise AuditError("raw_file_truncated")
+                digest.update(record)
+                cls = record[0]
+                if cls > 9:
+                    raise AuditError("raw_record_class")
+
+                record_end = offset + RECORD_BYTES
+                while (
+                    range_index < len(selected_ranges)
+                    and offset >= selected_ranges[range_index][1]
+                ):
+                    range_index += 1
+                if range_index < len(selected_ranges):
+                    start, end = selected_ranges[range_index]
+                    if start <= offset and record_end <= end and cls == class_index:
+                        durations.append(int.from_bytes(record[1:], "little"))
+                offset = record_end
+
+            if stream.read(1):
+                raise AuditError("raw_file_grew_during_read")
+            after = os.fstat(stream.fileno())
+            if (
+                not _same_file_identity(before, after)
+            ):
+                raise AuditError("raw_file_changed_during_read")
+            path_after = raw_path.lstat()
+            if (
+                stat.S_ISLNK(path_after.st_mode)
+                or not stat.S_ISREG(path_after.st_mode)
+                or not _same_file_identity(before, path_after)
+            ):
+                raise AuditError("raw_file_path_changed_during_read")
+    except AuditError:
+        raise
+    except OSError as exc:
+        raise AuditError("raw_file_io") from exc
+
+    actual_sha256 = digest.hexdigest()
+    if actual_sha256 != expected_sha256.lower():
+        raise AuditError("raw_file_sha256_mismatch")
+    return actual_sha256, file_size, selected_ranges, durations
+
+
+def _range_digest(ranges: list[tuple[int, int]]) -> str:
+    digest = hashlib.sha256()
+    for start, end in ranges:
+        digest.update(start.to_bytes(8, "little"))
+        digest.update(end.to_bytes(8, "little"))
+    return digest.hexdigest()
+
+
+def _numeric_summary(durations: list[int]) -> dict[str, object]:
+    durations.sort()
+    sample_count = len(durations)
+    p95_ns = durations[(95 * sample_count + 99) // 100 - 1] if sample_count else None
+    p99_ns = durations[(99 * sample_count + 99) // 100 - 1] if sample_count else None
+    maximum_ns = durations[-1] if sample_count else None
+    latency_pass = (
+        sample_count >= MIN_SAMPLES
+        and p95_ns <= P95_LIMIT_NS
+        and p99_ns <= P99_LIMIT_NS
+    )
+    return {
+        "selected_sample_count": sample_count,
+        "sample_count_gate": {
+            "status": "sufficient" if sample_count >= MIN_SAMPLES else "insufficient",
+            "required": MIN_SAMPLES,
+            "observed": sample_count,
+        },
+        "p95_ns": p95_ns,
+        "p99_ns": p99_ns,
+        "maximum_ns": maximum_ns,
+        "p95_limit_ns": P95_LIMIT_NS,
+        "p99_limit_ns": P99_LIMIT_NS,
+        "numeric_latency_gate": (
+            "passed_numeric_only"
+            if latency_pass
+            else "not_evaluable_insufficient_samples"
+            if sample_count < MIN_SAMPLES
+            else "failed_numeric_only"
+        ),
+    }
+
+
+def audit(
+    path: str | os.PathLike[str],
+    expected_sha256: str,
+    ranges: Iterable[tuple[int, int]],
+    class_index: int,
+) -> dict[str, object]:
+    """Verify one bounded raw file and summarize one class in eligible ranges.
+
+    Each record is exactly ``class:u8 + duration_ns:u64le``. Ranges are
+    half-open byte offsets, must be 9-byte aligned, and may not overlap. The
+    complete raw file is streamed once for both SHA-256 and record decoding.
+    Selected durations use an exact list bounded by the 128 KiB raw cap.
+    """
+    actual_sha256, file_size, selected_ranges, durations = _read_selected(
+        path, expected_sha256, ranges, class_index
+    )
+
+    return {
+        "schema": "mycity-raw-duration-numeric-audit-v1",
+        "raw_sha256": actual_sha256,
+        "raw_bytes": file_size,
+        "class_index": class_index,
+        "range_count": len(selected_ranges),
+        "ranges_sha256": _range_digest(selected_ranges),
+        "ranges_sha256_encoding": "sorted half-open u64le(start)||u64le(end) pairs",
+        **_numeric_summary(durations),
+        "eligibility_identity_observer_overlap_normal_memory_full_m0": "not_proven",
+    }
+
+
+def audit_many(
+    inputs: Iterable[
+        tuple[str | os.PathLike[str], str, Iterable[tuple[int, int]]]
+    ],
+    class_index: int,
+) -> dict[str, object]:
+    """Aggregate original durations across distinct raw files, then rank once.
+
+    Each input is ``(path, expected_sha256, ranges)`` and is streamed once by
+    the same verifier as :func:`audit`. The 600-file ceiling is the 200-trial
+    by three-producer raw-file ceiling; source-stratum worker files are usually
+    at most 400 (two workers per trial), with Sim records not made eligible by
+    this numeric-only function. The combined sample count does not prove 200
+    independent trials.
+
+    This is post-observer offline QA. At most 8,737,800 durations are retained
+    for exact global nearest-rank quantiles. The Python list plus integer
+    objects and in-place sort scratch are estimated at roughly 420 MiB at that
+    ceiling, excluding interpreter/allocator overhead. It is not a game-path
+    operation and does not demonstrate the DRIVER 1 MiB budget.
+    """
+    _validate_class_index(class_index)
+    durations: list[int] = []
+    file_summaries: list[dict[str, object]] = []
+    seen_inodes: set[tuple[int, int]] = set()
+    total_bytes = 0
+    total_ranges = 0
+
+    for ordinal, item in enumerate(inputs, start=1):
+        if ordinal > MAX_INPUT_FILES:
+            raise AuditError("too_many_input_files")
+        if not isinstance(item, (tuple, list)) or len(item) != 3:
+            raise AuditError("input_shape")
+        path, expected_sha256, ranges = item
+        actual_sha256, file_size, selected_ranges, samples = _read_selected(
+            path, expected_sha256, ranges, class_index, seen_inodes
+        )
+        total_bytes += file_size
+        if total_bytes > TOTAL_RAW_BYTE_CAP:
+            raise AuditError("total_raw_bytes_too_large")
+        if len(durations) + len(samples) > MAX_TOTAL_RECORDS:
+            raise AuditError("total_selected_records_too_large")
+        durations.extend(samples)
+        range_digest = _range_digest(selected_ranges)
+        total_ranges += len(selected_ranges)
+        file_summaries.append(
+            {
+                "ordinal": ordinal,
+                "path": os.fspath(path),
+                "raw_sha256": actual_sha256,
+                "raw_bytes": file_size,
+                "range_count": len(selected_ranges),
+                "ranges_sha256": range_digest,
+                "selected_sample_count": len(samples),
+            }
+        )
+
+    return {
+        "schema": "mycity-raw-duration-numeric-audit-many-v1",
+        "class_index": class_index,
+        "file_count": len(file_summaries),
+        "file_count_limit": MAX_INPUT_FILES,
+        "file_count_limit_basis": "200 trials x 3 producer raw-file ceiling; source worker files usually <=400",
+        "total_raw_bytes": total_bytes,
+        "total_raw_byte_limit": TOTAL_RAW_BYTE_CAP,
+        "effective_max_total_raw_bytes": EFFECTIVE_RAW_BYTE_CAP,
+        "total_range_count": total_ranges,
+        "range_binding_encoding": "per-file SHA-256 of sorted half-open u64le(start)||u64le(end) pairs",
+        "max_selected_records": MAX_TOTAL_RECORDS,
+        "offline_scratch_estimate": "about 420 MiB at max_selected_records; excludes interpreter/allocator overhead",
+        "execution_scope": "post-observer offline QA; not game-path and not DRIVER-budget evidence",
+        "independent_trial_count_gate": "not_proven",
+        "files": file_summaries,
+        **_numeric_summary(durations),
+        "eligibility_identity_observer_overlap_normal_memory_full_m0": "not_proven",
+    }
diff --git a/docs/evidence/m0-t13a-rare-control-01/observer_contract.py b/docs/evidence/m0-t13a-rare-control-01/observer_contract.py
new file mode 100644
index 0000000..bbb3730
--- /dev/null
+++ b/docs/evidence/m0-t13a-rare-control-01/observer_contract.py
@@ -0,0 +1,86 @@
+"""Fixed native observer summary checks; raw coverage remains a separate audit.
+
+Derived from candidate03 native_watch/summary.rs. A successful measurement
+wrapper is neither a physical-memory acceptance nor the complete rare gate.
+"""
+import math
+
+GIB = 1024 ** 3
+MIB = 1024 ** 2
+
+
+def nonnegative_number(value):
+    return type(value) in (int, float) and math.isfinite(value) and value >= 0
+
+
+def bounded_integer(value, cap):
+    return type(value) is int and 0 <= value <= cap
+
+
+def classify_observer_report(report, source, binary_sha256, expected_command):
+    """Require the exact command/identity; never promote wrapper exit to M0."""
+    identity = (
+        isinstance(report, dict)
+        and report.get("schema") == "mycity-bounded-native-group-observer-v1"
+        and report.get("source_sha256") == source
+        and report.get("binary_sha256") == binary_sha256
+        and report.get("command") == expected_command
+    )
+    if not identity:
+        return {"identity_matches": False, "wrapper_complete": False,
+                "full_M0": "not_accepted", "formal_rare_gate": "not_verified_observer_identity"}
+    complete = (
+        {"status", "reason", "cleanup_error", "binary_unchanged", "model_exit_code",
+         "actual_wall_seconds", "samples", "final_live_identity_count"} <= report.keys()
+        and report.get("status") == "passed_measurement_wrapper"
+        and report.get("reason") is None
+        and report.get("cleanup_error") is None
+        and report.get("binary_unchanged") is True
+        and type(report.get("model_exit_code")) is int
+        and report["model_exit_code"] == 0
+        and nonnegative_number(report.get("actual_wall_seconds"))
+        and report["actual_wall_seconds"] > 0
+        and type(report.get("samples")) is int and report["samples"] > 0
+        and type(report.get("final_live_identity_count")) is int
+        and report["final_live_identity_count"] == 1
+    )
+    summary_coverage = all(
+        type(report.get(key)) is int and report[key] == 0
+        for key in ("missing_footprint_process_samples", "missing_rss_process_samples",
+                    "unpolled_registered_processes")
+    )
+    # These are the unchanged measured guard bounds, not a new performance budget.
+    pressure = report.get("maximum_sampled_non_normal_pressure_seconds")
+    guards = (
+        bounded_integer(report.get("peak_world_logical_bytes"), 20 * GIB)
+        and bounded_integer(report.get("maximum_observed_swap_net_growth_bytes"), 256 * MIB)
+        and bounded_integer(report.get("sample_log_bytes"), 256 * MIB)
+        and nonnegative_number(pressure) and pressure <= 60
+    )
+    own = report.get("observer_hot_bound_bytes")
+    other = report.get("other_diagnostic_owned_bytes")
+    total = report.get("combined_diagnostic_hot_bound_bytes")
+    diagnostic = (
+        type(own) is int and own == 2 * MIB
+        and bounded_integer(other, 8 * MIB)
+        and bounded_integer(total, 8 * MIB)
+        and own + other == total
+    )
+    cadence_recorded = all(
