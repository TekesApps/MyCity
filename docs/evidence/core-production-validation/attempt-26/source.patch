+fn advance_to_day(store: &mut Store, target: u64) {
+    for _ in 0..128 {
+        execute(
+            store,
+            Action::Timeline {
+                command: TimelineCommand::Advance {
+                    target,
+                    limit: 8192,
+                },
+            },
+        );
+        if store
+            .engine()
+            .unwrap()
+            .timeline()
+            .unwrap()
+            .progress
+            .target
+            .is_none()
+        {
+            return;
+        }
+    }
+    panic!("timeline failed to reach target {target}");
+}
