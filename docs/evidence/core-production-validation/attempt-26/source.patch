+        let supplier = account(&low_cash, 4);
+        issue(
+            &mut low_cash,
+            Action::Transfer {
+                from: household,
+                to: supplier,
+                amount: cash(800),
+            },
+        );
+        assert_eq!(
+            low_cash
+                .world
+                .view()
+                .accounts
+                .iter()
+                .find(|row| row.id == 2)
+                .unwrap()
+                .cash,
